#!/usr/bin/env bash
# root 소유 /usr/local/sbin/buildflow-release 로 설치한다. buildflow-deploy는 sudo로 이 파일만 실행한다.
#
#   sudo buildflow-release status
#   sudo buildflow-release deploy <CI 검증된 origin/main 40자리 SHA>
#   sudo buildflow-release rollback <되돌릴 이전 40자리 SHA>
#
# deploy는 docs/RELEASE_RUNBOOK.md 순서를 그대로 실행한다: 처리 중 작업 0건 → 현재 이미지 보존 →
# main SHA 일치 확인·checkout → 순차 빌드 → 앱 정지 → 백업·격리 복원 확인 → 기동.
# 임의 명령·임의 브랜치는 받지 않는다. 볼륨 삭제·down -v·force 작업은 하지 않는다.
set -euo pipefail
umask 077

REPO=/opt/buildflow
HOST_FILE=/etc/buildflow/public_host
BACKUP_ROOT=/root/buildflow-backups
APPS=(frontend gateway-server auth-service site-service estimate-service purchase-service tax-service notification-service chat-service)

fail() { echo "중단: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || fail "root(sudo)로 실행한다"
[ -r "$HOST_FILE" ] || fail "$HOST_FILE 이 없다"
PUBLIC_HOST=$(tr -d '[:space:]' < "$HOST_FILE")
[[ "$PUBLIC_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || fail "공개 호스트명 형식이 아니다"
export PUBLIC_HOST
cd "$REPO"
C=(docker compose -f docker-compose.yml -f docker-compose.app.yml -f docker-compose.vps.yml -f docker-compose.public.yml)

MODE=${1:-}
SHA=${2:-}
check_sha() { [[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || fail "40자리 소문자 SHA만 허용한다"; }

status() {
  echo "HEAD $(git rev-parse HEAD)"
  "${C[@]}" ps --format 'table {{.Name}}\t{{.Status}}'
  echo "공개 / → $(curl -s -o /dev/null -m 10 -w '%{http_code}' "https://$PUBLIC_HOST/")"
  echo "무인증 API → $(curl -s -o /dev/null -m 10 -w '%{http_code}' "https://$PUBLIC_HOST/api/v1/sites")"
  # 업무 서비스 포트는 호스트에 게시하지 않으므로 컨테이너 안에서 health를 본다.
  for target in eureka:8761 config:8888 gateway:8080 auth:8081 estimate:8082 site:8083                 purchase:8084 tax:8085 notification:8086 chat:8087; do
    if docker exec "buildflow-${target%%:*}" wget -qO- -T 5 "http://localhost:${target##*:}/actuator/health" 2>/dev/null | grep -q '"UP"'; then
      echo "health ${target} UP"
    else
      echo "health ${target} 실패"
    fi
  done
}

pending_work() {
  docker exec buildflow-mysql sh -c 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -B -e "
SELECT (SELECT COUNT(*) FROM buildflow_notification.outbox_events WHERE status IN (\"PENDING\",\"CLAIMED\"))
     + (SELECT COUNT(*) FROM buildflow_estimate.outbox_events WHERE status IN (\"PENDING\",\"CLAIMED\"))
     + (SELECT COUNT(*) FROM buildflow_purchase.outbox_events WHERE status IN (\"PENDING\",\"CLAIMED\"))
     + (SELECT COUNT(*) FROM buildflow_tax.outbox_events WHERE status IN (\"PENDING\",\"CLAIMED\"))
     + (SELECT COUNT(*) FROM buildflow_notification.defect_warranties WHERE ocr_status = \"PENDING\")" 2>/dev/null'
}

case "$MODE" in
  status)
    status
    ;;
  deploy)
    check_sha
    [ -z "$(git status --porcelain)" ] || fail "작업 트리가 깨끗하지 않다"
    OLD=$(git rev-parse HEAD)
    git fetch -q origin main:refs/remotes/origin/main
    [ "$(git rev-parse origin/main)" = "$SHA" ] || fail "origin/main($(git rev-parse origin/main))이 요청 SHA와 다르다"
    [ "$OLD" != "$SHA" ] || fail "이미 $SHA 이다"
    PENDING=$(pending_work)
    [ "$PENDING" = "0" ] || fail "처리 중 outbox/OCR 작업 ${PENDING}건. 끝난 뒤 다시 실행한다"
    echo "== 되돌리기 기준 OLD=$OLD"
    for img in $(docker ps --filter name=buildflow- --format '{{.Image}}' | sort -u); do
      docker image tag "$img" "${img%%:*}:pre-${OLD:0:12}"
    done
    git switch -q --detach "$SHA"
    "${C[@]}" config --quiet
    "${C[@]}" config --format json | python3 scripts/vps/verify_public_compose.py
    echo "== 순차 빌드(운영 컨테이너는 계속 동작)"
    if ! bash scripts/vps/build_images.sh; then
      git switch -q --detach "$OLD"; fail "빌드 실패. 코드만 $OLD 로 되돌렸고 운영 컨테이너는 그대로다"
    fi
    echo "== 앱 정지 후 백업·격리 복원 확인"
    "${C[@]}" stop "${APPS[@]}"
    install -d -m 700 "$BACKUP_ROOT"
    if ! bash scripts/vps/predeploy_backup.sh "$BACKUP_ROOT"; then
      git switch -q --detach "$OLD"
      "${C[@]}" start "${APPS[@]}"
      fail "백업 확인 실패. 코드를 $OLD 로 되돌리고 기존 앱을 다시 켰다"
    fi
    echo "== 새 버전 기동"
    "${C[@]}" up -d --no-build
    sleep 60
    status
    echo "완료: $OLD → $SHA (되돌리기: sudo buildflow-release rollback $OLD)"
    ;;
  rollback)
    check_sha
    git cat-file -e "$SHA^{commit}" 2>/dev/null || fail "알 수 없는 커밋"
    TAG="pre-${SHA:0:12}"
    [ -n "$(docker images --format '{{.Tag}}' | grep -x "$TAG")" ] || fail "$TAG 이미지가 없다"
    git switch -q --detach "$SHA"
    for img in $(docker images --format '{{.Repository}}:{{.Tag}}' | grep ":$TAG$"); do
      docker image tag "$img" "${img%%:*}:latest"
    done
    "${C[@]}" up -d --no-build
    sleep 60
    status
    echo "되돌림: HEAD=$SHA (DB 스키마 추가분은 이전 코드와 호환되어 그대로 둔다)"
    ;;
  *)
    fail "사용법: buildflow-release status | deploy <sha> | rollback <sha>"
    ;;
esac
