# 기본 텍스트 자동 감지
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
docker-compose.vps.yml text eol=lf
docker-compose.public.yml text eol=lf
.env.example text eol=lf
.github/workflows/ci.yml text eol=lf
frontend/nginx.conf text eol=lf
frontend/src/api/sites.api.ts text eol=lf
frontend/src/api/sites.api.test.tsx text eol=lf
deploy/caddy/Caddyfile text eol=lf
estimate-service/src/main/resources/application.yml text eol=lf
notification-service/src/main/resources/application.yml text eol=lf

# Unix 스크립트는 Windows checkout에서도 LF 유지
*.sh text eol=lf
*.py text eol=lf
gradlew text eol=lf

# Windows 실행 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 파일은 변환 금지
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.zip binary
