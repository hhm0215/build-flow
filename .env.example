# ─────────────────────────────────────────
# BuildFlow 환경변수 설정
# 이 파일을 복사하여 .env 로 사용:  cp .env.example .env
# .env는 .gitignore에 포함되어 커밋되지 않음
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# MySQL
# ─────────────────────────────────────────
DB_ROOT_PASSWORD=buildflow123
DB_USERNAME=root
DB_PASSWORD=buildflow123
# DB_HOST는 docker 환경에서 'mysql', 로컬 직접 실행 시 'localhost' (application.yml default)

# ─────────────────────────────────────────
# JWT (auth-service + gateway-server)
# ─────────────────────────────────────────
# HS512 권장: 최소 512비트(64바이트). 운영 시 반드시 강한 무작위값으로 교체
JWT_SECRET=buildflow-jwt-secret-key-must-be-at-least-32-characters-long

# ─────────────────────────────────────────
# AI (estimate-service / site-service)
# ─────────────────────────────────────────
# Ollama 로컬 LLM 사용 (ADR-006 참고. Claude API → Ollama 전환됨)
# default 값 그대로 OK — 변경 시에만 주석 해제:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=120

# Claude API (Ollama 전환 후 미사용 — 빈 값 OK)
CLAUDE_API_KEY=

# ─────────────────────────────────────────
# 기타 (default 그대로 OK — 변경 시에만 주석 해제)
# ─────────────────────────────────────────
# REDIS_HOST=localhost           # docker: redis
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # docker: kafka:9092
# CORS_ALLOWED_ORIGINS=http://localhost:3000
