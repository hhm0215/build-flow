# ─────────────────────────────────────────
# BuildFlow 환경변수 설정
# 변수 목록 참고용 템플릿. Windows fresh clone은 scripts/buildflow.ps1 check 사용
# 수동 복사 시 빈 필수값(DB/JWT)을 직접 채워야 함
# .env는 .gitignore에 포함되어 커밋되지 않음
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# MySQL
# ─────────────────────────────────────────
# scripts/buildflow.ps1 check가 fresh clone에서 안전한 값을 자동 생성함
DB_ROOT_PASSWORD=
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST는 docker 환경에서 'mysql', 로컬 직접 실행 시 'localhost' (application.yml default)

# ─────────────────────────────────────────
# JWT (auth-service + gateway-server)
# ─────────────────────────────────────────
# HS512 권장: 최소 512비트(64바이트) 무작위값
JWT_SECRET=

# ─────────────────────────────────────────
# AI (estimate-service / site-service)
# ─────────────────────────────────────────
# Ollama 로컬 LLM 사용 (ADR-006 참고. Claude API → Ollama 전환됨)
# full Docker 기본값: http://host.docker.internal:11434 (호스트 native Ollama)
# 로컬 Java 기본값: http://localhost:11434
# Docker Ollama profile 사용 시에만 다음 값을 설정:
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT=120

# Claude API (Ollama 전환 후 미사용 — 빈 값 OK)
CLAUDE_API_KEY=

# ─────────────────────────────────────────
# 기타 (default 그대로 OK — 변경 시에만 주석 해제)
# ─────────────────────────────────────────
# REDIS_HOST=localhost           # docker: redis
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094   # Docker 내부 앱: kafka:9092
# CORS_ALLOWED_ORIGINS=http://localhost:3000
