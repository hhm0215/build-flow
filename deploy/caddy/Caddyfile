{
    servers {
        strict_sni_host on
    }
}

# Automatic HTTPS inserts the known-host redirect before this catch-all.
# Unknown HTTP Host values must not redirect clients to arbitrary domains.
http:// {
    respond 421
}

{$PUBLIC_HOST} {
    encode zstd gzip

    header {
        # HTTPS 전용 호스트에만 HSTS. PUBLIC_HOST가 apex인지 하위 도메인인지 운영자가 확인하기 전에는
        # 형제 하위 도메인까지 묶는 includeSubDomains·preload를 붙이지 않는다.
        # CSP(Report-Only)는 frontend Nginx가 붙인다 — 여기서 중복 설정하지 않는다.
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }

    reverse_proxy frontend:80 {
        # Do not forward a client-supplied X-Forwarded-For value to Nginx's
        # per-client login limiter.
        header_up X-Forwarded-For {remote_host}
    }
}
